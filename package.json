{
  "name": "itscloudy-server",
  "version": "2.0.0",
  "description": "Serveur de l'application ItsCloudy",
  "main": "app.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "dev": "tsc --noEmit && tsx --watch src/app.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsCloudym/itscloudy-server.git"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@logtail/winston": "^0.5.2",
    "@sentry/cli": "^2.43.0",
    "@sentry/node": "^9.14.0",
    "dotenv": "^16.4.7",
    "expres": "^0.0.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.2.0",
    "googleapis": "^159.0.0",
    "https": "^1.0.0",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.6",
    "oci-common": "^2.89.4",
    "oci-objectstorage": "^2.89.4",
    "oci-sdk": "^2.89.2",
    "oracledb": "^6.8.0",
    "pm2": "^6.0.14",
    "winston": "^3.17.0"
  },
  "_moduleAliases": {
    "@root": "src",
    "@routes": "src/routes",
    "@api": "src/data/api",
    "@fields": "src/data/fields",
    "@models": "src/data/models",
    "@repositories": "src/data/repositories",
    "@queries": "src/data/queries",
    "@controllers": "src/controllers",
    "@utils": "src/utils",
    "@middlewares": "src/middlewares"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/oracledb": "^6.10.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
